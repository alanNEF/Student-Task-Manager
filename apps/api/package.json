{
  "name": "@student-task-manager/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "npm run build -w @student-task-manager/shared",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @student-task-manager/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@student-task-manager/shared": "1.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6"
  },
  "engines": {
    "node": ">=22"
  }
}
